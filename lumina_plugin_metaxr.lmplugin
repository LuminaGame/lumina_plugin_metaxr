{
  "name": "lumina_plugin_metaxr",
  "friendly_name": "MetaXR Support",
  "version": "0.2.0",
  "description": "Meta Quest OpenXR SDK features: Passthrough MR layers, 26-joint hand tracking with pinch detection, spatial anchors, room scene perception, and social face/eye tracking.",
  "category": "Virtual Reality",
  "license": "MIT",
  "changelog": "CHANGELOG.md",
  "authors": [
    "Lumina"
  ],
  "engine_version": ">=0.0.1 <1.0.0",
  "can_contain_content": false,
  "isolation": "process",
  "dependencies": [
    {
      "name": "lumina_plugin_openxr",
      "version": ">=0.1.0"
    }
  ],
  "modules": [
    {
      "name": "lumina_plugin_metaxr",
      "type": "editor",
      "entry_library": "lib/lumina_plugin_metaxr.dart",
      "process_class": "MetaXrProcess"
    },
    {
      "name": "lumina_plugin_metaxr_runtime",
      "type": "runtime",
      "entry_library": "lib/runtime.dart",
      "registration_class": "LuminaMetaXrRuntime"
    }
  ],
  "android": {
    "uses_features": [
      {
        "name": "com.oculus.feature.PASSTHROUGH",
        "required": false,
        "required_when_used": "LuminaMetaPassthroughComponent"
      },
      {
        "name": "oculus.software.handtracking",
        "required": false,
        "when_used": "LuminaMetaHandTrackingComponent"
      }
    ],
    "permissions": [
      {
        "name": "com.oculus.permission.HAND_TRACKING",
        "when_used": "LuminaMetaHandTrackingComponent"
      }
    ],
    "meta_data": [
      {
        "name": "com.oculus.supportedDevices",
        "value": "quest3|quest3s|quest2|questpro"
      }
    ]
  }
}
